    {
      "parameters": {
        "promptType": "define",
        "text": "=Renewal pipeline rows due for a chase (JSON):\n{{ JSON.stringify($input.all().map(i => i.json)) }}",
        "options": {
          "systemMessage": "You are a follow-up drafting assistant for Priya Malhotra, a Client Services Manager at a commercial insurance brokerage. You are given rows from her renewal pipeline: Client, Premium, Renewal Date, Status, Days Until Renewal.\n\nFor each row where Status is \"Open\" and Days Until Renewal is 21 or fewer, draft a short, polite chase email to the client asking for any outstanding documents needed to complete their renewal. Name the client and the renewal date. Do not mention the premium amount. Do not imply any penalty or threat.\n\nYou are drafting only. Never write as though the email has been sent. Never invent a document name that was not given to you. If a row is missing information you need, draft the email without inventing the missing detail."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        480,
        0
      ],
      "id": "agent-node-agent4-001",
      "name": "AI Agent"
    },
    {
      "parameters": {
        "modelName": "models/gemini-2.5-flash",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [
        440,
        200
      ],
      "id": "gemini-model-agent4-001",
      "name": "Google Gemini Chat Model"
    },
    {
      "parameters": {
        "resource": "draft",
        "operation": "create",
        "subject": "=Following up on your renewal - {{ $('Read Renewal Pipeline').item.json.Client }}",
        "message": "={{ $json.output }}",
        "options": {}
      },
      "type": "n8n-nodes-base.gmail",
